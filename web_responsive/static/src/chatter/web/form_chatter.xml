<templates xml:space="preserve">
    <t t-name="web_responsive.FormChatter">
        <t t-if="props.isChatterAside">
            <ResizablePanel
                handleSide="'start'"
                class="props.chatterContainerClass"
                minWidth="minWidth"
                initialWidth="chatterWidth"
                onResize.bind="onResize"
            >
                <t t-component="props.chatterComponent" t-props="chatterProps" />
            </ResizablePanel>
        </t>
        <div t-else="" t-att-class="props.chatterContainerClass">
            <t t-component="props.chatterComponent" t-props="chatterProps" />
        </div>
    </t>
</templates>

<template>
    <t
        t-name="web_responsive.FileViewer"
        t-inherit="web.FileViewer"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('o-FileViewer')]/.." position="attributes">
            <attribute name="class" add="o-FileViewerContainer" separator=" " />
            <attribute name="t-attf-class">
                {{ props.isPopout ? 'o-FileViewerContainer__popout' : state.maximized ? 'o-FileViewerContainer__maximized' : 'o-FileViewerContainer__minimized' }}
            </attribute>
            <attribute name="t-ref">root</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o-FileViewer-header')]" position="attributes">
            <attribute name="t-if">!props.isPopout</attribute>
        </xpath>
        <xpath expr="//div[@t-on-click.stop='close']" position="before">
            <div
                t-on-click.stop="onClickPopout"
                class="o-FileViewer-headerButton d-flex align-items-center mb-0 px-3 h4 text-reset cursor-pointer"
                role="button"
                name="popout"
                title="Open in a separate window"
                aria-label="Open in a separate window"
            >
                <i class="fa fa-fw fa-window-restore" role="img" />
            </div>
            <div
                t-if="state.allowMinimize"
                t-on-click="toggleMaximized"
                class="o-FileViewer-headerButton d-flex align-items-center mb-0 px-3 h4 text-reset cursor-pointer"
                role="button"
                t-att-name="state.maximized ? 'minimize' : 'maximize'"
                t-att-title="maximizeLabel"
                t-att-aria-label="maximizeLabel"
            >
                <i
                    class="fa fa-fw"
                    t-att-class="state.maximized ? 'fa-window-minimize' : 'fa-window-maximize'"
                    role="img"
                />
            </div>
        </xpath>
    </t>
</template>

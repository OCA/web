<templates>
    <!-- Search bar -->
    <t t-name="web_responsive.AppsMenuCanonicalSearchBar">
        <div
            class="search-container"
            t-att-class="{'has-results': this.state.hasResults}"
        >
            <div class="search-input">
                <i
                    class="oi search-icon fs-4 my-auto d-none d-sm-flex"
                    data-icon="search"
                />
                <input
                    type="search"
                    t-ref="this.searchBarInputRef"
                    t-on-input="this._searchMenus"
                    t-on-keydown="this._onKeyDown"
                    autocomplete="off"
                    placeholder="Search menus..."
                    class="form-control"
                />
            </div>
            <ul
                t-if="this.hasItemsToDisplay"
                class="list-unstyled search-list"
                t-ref="this.searchItemsRef"
            >
                <t t-foreach="this.state.rootItems" t-as="menu" t-key="menu.id">
                    <li t-attf-class="search-item {{this.highlighted(menu_index)}}">
                        <a
                            t-attf-class="search-item__link"
                            t-att-href="menu.path"
                            t-att-data-menu-id="menu.id"
                            t-att-data-action-id="menu.actionID"
                            draggable="false"
                            tabindex="-1"
                        >
                            <img
                                class="search-item__image"
                                t-att-src="menu.webIconData"
                                alt="App Icon"
                            />
                            <span class="search-item__name" t-att-title="menu.name">
                                <t
                                    t-foreach="this._splitName(menu.displayName)"
                                    t-as="name"
                                    t-key="name_index"
                                >
                                    <b t-if="name_index % 2" t-out="name" />
                                    <t t-else="" t-out="name" />
                                </t>
                            </span>
                        </a>
                    </li>
                </t>
                <li
                    class="search-item-divider"
                    t-if="this.state.rootItems.length and this.state.subItems.length"
                >
                    <hr class="w-100" />
                </li>
                <t t-foreach="this.state.subItems" t-as="menu" t-key="menu.id">
                    <li
                        t-attf-class="search-item {{this.highlighted(menu_index, true)}}"
                    >
                        <a
                            t-attf-class="search-item__link"
                            t-att-href="menu.path"
                            t-att-data-menu-id="menu.id"
                            t-att-data-action-id="menu.actionID"
                            draggable="false"
                            tabindex="-1"
                        >
                            <span
                                class="search-item__name px-2 py-1"
                                t-att-title="menu.name"
                            >
                                <t
                                    t-foreach="this._splitName(menu.displayName)"
                                    t-as="name"
                                    t-key="name_index"
                                >
                                    <b t-if="name_index % 2" t-out="name" />
                                    <t t-else="" t-out="name" />
                                </t>
                            </span>
                        </a>
                    </li>
                </t>
            </ul>
            <ul
                t-if="!this.hasItemsToDisplay and this.inputValue"
                class="list-unstyled search-list"
            >
                <li class="empty-search-item">
                    <strong>Nothing to show</strong>
                </li>
            </ul>
        </div>
    </t>
</templates>

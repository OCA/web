<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.web.font</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="languages_setting_container" position="inside">
                <setting
                    id="web_font_setting"
                    help="Font used in the backend. Reload the page to apply."
                >
                    <field name="web_font" placeholder="Odoo Default" />
                    <div class="content-group" invisible="not web_font">
                        <div class="row mt8">
                            <label for="web_font_size" class="col-lg-4 o_light_label" />
                            <field name="web_font_size" />
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>

<template>
    <t t-name="web_widget_image_download.DownloadButton">
        <div
            t-attf-class="position-absolute d-flex justify-content-between top-0 opacity-0 opacity-100-hover {{this.isMobile ? 'o_mobile_controls' : ''}}"
            aria-atomic="true"
            t-att-style="this.sizeStyle"
        >
            <button
                t-if="this.props.record.data[this.props.name] and this.state.isValid"
                class="o_form_binary_file_download btn btn-light border-0 rounded-circle m-1 p-1"
                data-tooltip="Download"
                aria-label="Download"
                t-on-click="this.onFileDownload"
            >
                <i class="oi oi-fw" data-icon="download" />
            </button>
        </div>
    </t>

    <t
        t-name="web_widget_image_download.ImageField"
        t-inherit="web.ImageField"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('o_image_uploader_container')]" position="after">
            <t t-call="web_widget_image_download.DownloadButton" />
        </xpath>
    </t>

    <!-- web.ContactImageField is a primary copy of web.ImageField, which does not
         get the extension above. Since 20.0 it is the widget of the partner, user
         and company forms. -->
    <t
        t-name="web_widget_image_download.ContactImageField"
        t-inherit="web.ContactImageField"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('o_image_uploader_container')]" position="after">
            <t t-call="web_widget_image_download.DownloadButton" />
        </xpath>
    </t>
</template>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="portal_my_home_discuss" inherit_id="portal.portal_my_home">
        <xpath expr="//div[@id='portal_common_category']/*[1]" position="before">
            <t t-call="portal.portal_docs_entry">
                <t
                    t-set="icon"
                    t-value="'/web_portal_discuss/static/src/img/discuss_portal.svg'"
                />
                <t t-set="title">Discussions</t>
                <t t-set="text">Échange direct avec l’équipe de votre entreprise</t>
                <t t-set="url" t-value="'/my/discuss'" />
                <t t-set="config_card" t-value="True" />
            </t>
        </xpath>
    </template>

    <!-- Keep the native Discuss document and display only a compact,
         full-width portal breadcrumb with the current website logo. -->
    <template id="portal_discuss" name="Portal Discuss">
        <t t-call="mail.discuss_public_channel_template">
            <t t-set="title">Discussions</t>
            <t t-set="session_info" t-value="session_info" />
            <t t-set="data" t-value="discuss_data" />
            <t t-set="body">
                <div class="o_portal_discuss_shell">
                    <nav class="o_portal_discuss_breadcrumb" aria-label="Fil d’Ariane">
                        <div class="o_portal_discuss_breadcrumb_inner">
                            <a
                                href="/my"
                                class="o_portal_discuss_brand"
                                aria-label="Accueil"
                                title="Accueil"
                            >
                                <span
                                    role="img"
                                    t-att-aria-label="'Logo de %s' % website.name"
                                    t-att-title="website.name"
                                >
                                    <img
                                        t-att-src="website.image_url(website, 'logo')"
                                        class="img img-fluid"
                                        t-att-alt="website.name"
                                        loading="lazy"
                                    />
                                </span>
                            </a>
                            <ol class="o_portal_submenu breadcrumb mb-0 px-0">
                                <li class="breadcrumb-item">
                                    <a href="/my" aria-label="Accueil" title="Accueil">
                                        <i class="fa fa-home" />
                                    </a>
                                </li>
                                <li class="breadcrumb-item active" aria-current="page">
                                    Discussions
                                </li>
                            </ol>
                        </div>
                    </nav>
                    <div t-if="not channels" class="container text-center py-5">
                        <h3>Discussions</h3>
                        <p
                            class="text-muted"
                        >Vous n’êtes membre d’aucune discussion.</p>
                        <a href="/contactus" class="btn btn-primary">
                            Demander un canal de discussion à notre équipe commerciale
                        </a>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>

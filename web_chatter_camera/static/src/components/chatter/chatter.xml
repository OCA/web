<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Followers')]" position="before">
            <button
                t-if="showCameraButton"
                class="o-mail-Chatter-camera btn btn-link text-action px-1 d-flex align-items-center"
                t-att-class="{ 'my-2': !props.compactHeight }"
                type="button"
                aria-label="Camera"
                title="Camera"
                t-att-disabled="state.isSearchOpen or (state.thread.id and !state.thread.canPostMessage)"
                t-on-click="onClickCamera"
            >
                <i class="fa fa-camera fa-lg me-1" role="img" aria-label="Camera" />
            </button>
            <input
                t-if="showCameraButton"
                type="file"
                t-ref="cameraInputRef"
                class="o-mail-Chatter-cameraInput d-none"
                accept="image/*"
                capture="environment"
                t-on-change="onCameraInputChange"
            />
        </xpath>
    </t>
</templates>

<odoo>
    <record id="view_partner_form_json_demo" model="ir.ui.view">
        <field name="name">res.partner.form.json.demo</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="JSON Data">
                    <field name="demo_json_data" widget="json_editor" />
                </page>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- res.partner / parent_id — always available in base Odoo -->
    <record id="template_res_partner" model="web.diagram.builder.template">
        <field name="name">Partner Hierarchy</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="recursive_field_id" search="[('model', '=', 'res.partner'), ('name', '=', 'parent_id')]"/>
        <field name="description">
            Show the parent/child hierarchy of partners using the parent_id field.
        </field>
    </record>

    <!-- res.users.role hierarchy if role module is installed — skip if not present -->

</odoo>

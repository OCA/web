#. module: web_diagram_builder
#: model:ir.model.fields,field_description:web_diagram_builder.field_web_diagram_builder__model_id
#: model:ir.model.fields,field_description:web_diagram_builder.field_web_diagram_builder_template__model_id
msgid "Model"
msgstr "Modèle"

#. module: web_diagram_builder
#: model:ir.model.fields,help:web_diagram_builder.field_web_diagram_builder__model_id
msgid "The model whose records will be displayed as nodes in the diagram."
msgstr "Le modèle dont les enregistrements seront affichés comme nœuds dans le diagramme."

#. module: web_diagram_builder
#: model:ir.model.fields,field_description:web_diagram_builder.field_web_diagram_builder__model_name
#: model:ir.model.fields,field_description:web_diagram_builder.field_web_diagram_builder_template__model_name
msgid "Model Technical Name"
msgstr "Nom technique du modèle"

#. module: web_diagram_builder
#: model:ir.model.fields,field_description:web_diagram_builder.field_web_diagram_builder__recursive_field_id
#: model:ir.model.fields,field_description:web_diagram_builder.field_web_diagram_builder_template__recursive_field_id
msgid "Parent Field"
msgstr "Champ parent"

#. module: web_diagram_builder
#: model:ir.model.fields,help:web_diagram_builder.field_web_diagram_builder__recursive_field_id
#: model:ir.model.fields,help:web_diagram_builder.field_web_diagram_builder_template__recursive_field_id
msgid ""
"The field that links a record to its parent. Must be a Many2one pointing to "
"the same model (e.g. parent_id on Contact)."
msgstr ""
"Le champ qui relie un enregistrement à son parent. Doit être un Many2one "
"pointant vers le même modèle (ex. parent_id sur Contact)."

#. module: web_diagram_builder
#: model:ir.model.fields,field_description:web_diagram_builder.field_web_diagram_builder__filter_domain
msgid "Filter Domain"
msgstr "Domaine de filtrage"

#. module: web_diagram_builder
#: model:ir.model.fields,help:web_diagram_builder.field_web_diagram_builder__filter_domain
msgid ""
"Domain to select the initial set of records. Parents are automatically "
"included to complete the chain."
msgstr ""
"Domaine pour sélectionner l'ensemble initial d'enregistrements. Les parents "
"sont automatiquement inclus pour compléter la chaîne."

#. module: web_diagram_builder
#: model:ir.model.fields,field_description:web_diagram_builder.field_web_diagram_builder__max_nodes
msgid "Max Nodes"
msgstr "Nombre maximum de nœuds"

#. module: web_diagram_builder
#: model:ir.model.fields,help:web_diagram_builder.field_web_diagram_builder__max_nodes
msgid "Safety limit on the number of nodes. Traversal stops when this limit is reached."
msgstr "Limite de sécurité sur le nombre de nœuds. Le parcours s'arrête lorsque cette limite est atteinte."

#. module: web_diagram_builder
#: model:ir.model.fields,field_description:web_diagram_builder.field_web_diagram_builder__auto_refresh
msgid "Auto-refresh"
msgstr "Rafraîchissement automatique"

#. module: web_diagram_builder
#: model:ir.model.fields,help:web_diagram_builder.field_web_diagram_builder__auto_refresh
msgid "If enabled, the diagram is automatically recomputed by the scheduled cron job."
msgstr "Si activé, le diagramme est automatiquement recalculé par la tâche planifiée."

#. module: web_diagram_builder
#: model:ir.model.fields,field_description:web_diagram_builder.field_web_diagram_builder__template_id
msgid "Apply Template"
msgstr "Appliquer un modèle"

#. module: web_diagram_builder
#: model:ir.model.fields,help:web_diagram_builder.field_web_diagram_builder__template_id
msgid "Select a template to pre-fill Model and Parent Field."
msgstr "Sélectionnez un modèle pour préremplir le Modèle et le Champ parent."

#. module: web_diagram_builder

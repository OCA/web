#: model:ir.model.fields,field_description:web_diagram_builder.field_web_diagram_builder_link__builder_id
msgid "Builder"
msgstr "Constructeur"

#. module: web_diagram_builder
#: model:ir.model.fields,field_description:web_diagram_builder.field_web_diagram_builder_link__source_node_id
msgid "Source"
msgstr "Source"

#. module: web_diagram_builder
#: model:ir.model.fields,field_description:web_diagram_builder.field_web_diagram_builder_link__dest_node_id
msgid "Destination"
msgstr "Destination"

#. module: web_diagram_builder
#: model:ir.model.fields,field_description:web_diagram_builder.field_web_diagram_builder_link__signal
msgid "Label"
msgstr "Étiquette"

#. module: web_diagram_builder
#: model:ir.model.fields,field_description:web_diagram_builder.field_web_diagram_builder_node__record_id
msgid "Record"
msgstr "Enregistrement"

#. module: web_diagram_builder
#: model:ir.model.fields,help:web_diagram_builder.field_web_diagram_builder_node__record_id
msgid "ID of the real record this node represents."
msgstr "ID de l'enregistrement réel que ce nœud représente."

#. module: web_diagram_builder
#: model:ir.model.fields,field_description:web_diagram_builder.field_web_diagram_builder_node__flow_start
msgid "Root Node"
msgstr "Nœud racine"

#. module: web_diagram_builder
#: model:ir.model.fields,help:web_diagram_builder.field_web_diagram_builder_node__flow_start
msgid "Root nodes have no parent and appear as starting points in the diagram."
msgstr "Les nœuds racines n'ont pas de parent et apparaissent comme points de départ dans le diagramme."

#. module: web_diagram_builder
#: model:ir.model.fields,field_description:web_diagram_builder.field_web_diagram_builder_node__outgoing_link_ids
msgid "Outgoing Links"
msgstr "Liens sortants"

#. module: web_diagram_builder
#: model:ir.model.fields,field_description:web_diagram_builder.field_web_diagram_builder_node__incoming_link_ids
msgid "Incoming Links"
msgstr "Liens entrants"

#. module: web_diagram_builder
#: model:ir.model.fields,field_description:web_diagram_builder.field_ir_model__has_hierarchy
msgid "Supports Hierarchy"
msgstr "Supporte la hiérarchie"

#. module: web_diagram_builder
#: model:ir.model.fields,help:web_diagram_builder.field_ir_model__has_hierarchy
msgid ""
"True if the model has at least one many2one field pointing to itself, making "
"it usable in the diagram builder."
msgstr ""
"Vrai si le modèle possède au moins un champ Many2one pointant vers lui-même, "
"ce qui le rend utilisable dans le constructeur de diagramme."

#. module: web_diagram_builder
#: model:ir.model.fields,field_description:web_diagram_builder.field_web_diagram_builder_import__file_ids
msgid "CSV Files"
msgstr "Fichiers CSV"

#. module: web_diagram_builder
#: model_terms:ir.ui.view,arch_db:web_diagram_builder.view_web_diagram_builder_import_form
msgid "Upload one or more CSV files exported from Diagram Builder. Each diagram will be recreated and recomputed automatically. If a file fails, the others will still be imported."
msgstr "Téléversez un ou plusieurs fichiers CSV exportés depuis le constructeur de diagramme. Chaque diagramme sera recréé et recalculé automatiquement. Si un fichier échoue, les autres seront quand même importés."

#. module: web_diagram_builder
#: model:ir.model.fields,help:web_diagram_builder.field_web_diagram_builder_import__file_ids
msgid "Select one or more CSV files exported from Diagram Builder."
msgstr "Sélectionnez un ou plusieurs fichiers CSV exportés depuis le constructeur de diagramme."

#. module: web_diagram_builder
#: model:ir.model.fields,field_description:web_diagram_builder.field_web_diagram_builder_import_result__line_ids
msgid "Results"
msgstr "Résultats"

#. module: web_diagram_builder
#: model:ir.model.fields,field_description:web_diagram_builder.field_web_diagram_builder_import_result_line__file_name
msgid "File"

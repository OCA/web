<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="web_pivot_computed_measure.ReportViewComputedMeasures"
        t-inherit="web.ReportViewMeasures"
        t-inherit-mode="primary"
    >
        <xpath expr="//DropdownItem" position="attributes">
            <attribute name="t-if">!this.isComputedMeasure(measure)</attribute>
        </xpath>
        <xpath expr="//t[@t-foreach='this.props.measures']" position="after">
            <div class="dropdown-divider" role="separator" />
            <t t-foreach="this.computedMeasures" t-as="measure" t-key="measure">
                <DropdownItem
                    class="{ o_menu_item: true, o_computed_measure: true, selected: this.props.activeMeasures.includes(measure) }"
                    closingMode="'none'"
                    t-out="this.props.measures[measure].string"
                    onSelected="() => this.props.onMeasureSelected({ measure: measure })"
                />
            </t>
            <DropdownItemCustomMeasure
                measures="this.props.measures"
                model="this.props.model"
            />
        </xpath>
    </t>
</templates>

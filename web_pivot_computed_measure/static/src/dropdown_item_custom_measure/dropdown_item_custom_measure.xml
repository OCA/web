<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="web_pivot_computed_measure.DropdownItemCustomMeasure">
        <AccordionItem
            class="'o_computed_measure_toggle'"
            description.translate="Computed Measure"
        >
            <div
                id="add_computed_measure_wrapper"
                class="d-flex flex-column gap-1 pe-3"
            >
                <label for="computed_measure_field_1">Measure 1</label>
                <select
                    id="computed_measure_field_1"
                    class="o_input"
                    t-model.proxy="this.state.field1"
                >
                    <t
                        t-foreach="this.availableMeasures"
                        t-as="measure"
                        t-key="measure"
                    >
                        <option
                            t-att-value="measure"
                            t-out="this.props.measures[measure].string"
                        />
                    </t>
                </select>
                <label for="computed_measure_field_2">Measure 2</label>
                <select
                    id="computed_measure_field_2"
                    class="o_input"
                    t-model.proxy="this.state.field2"
                >
                    <t
                        t-foreach="this.availableMeasures"
                        t-as="measure"
                        t-key="measure"
                    >
                        <option
                            t-att-value="measure"
                            t-out="this.props.measures[measure].string"
                        />
                    </t>
                </select>
                <label for="computed_measure_operation">Operation</label>
                <select
                    id="computed_measure_operation"
                    class="o_input"
                    t-on-change="this.onChangeOperation"
                >
                    <t
                        t-foreach="this.operations"
                        t-as="operation"
                        t-key="operation.key"
                    >
                        <option
                            t-att-value="operation.value"
                            t-att-data-key="operation.key"
                            t-att-selected="operation.key === this.state.operationKey"
                            t-out="operation.label"
                        />
                    </t>
                    <option
                        t-if="this.isDebug"
                        value="custom"
                        data-key="custom"
                        t-att-selected="this.state.operationKey === 'custom'"
                    >Custom</option>
                </select>
                <t t-if="this.state.operationKey === 'custom'">
                    <label for="computed_measure_operation_custom">Formula</label>
                    <input
                        id="computed_measure_operation_custom"
                        class="o_input"
                        type="text"
                        placeholder="(m1 + m2) / 2"
                        t-model.proxy="this.state.customOperation"
                    />
                </t>
                <label for="computed_measure_name">Name</label>
                <input
                    id="computed_measure_name"
                    class="o_input"
                    placeholder="Can be empty"
                    type="text"
                    t-model.proxy="this.state.name"
                />
                <label for="computed_measure_format">Format</label>
                <select
                    id="computed_measure_format"
                    class="o_input"
                    t-model.proxy="this.state.format"
                >
                    <option value="integer">Integer</option>
                    <option value="float">Float</option>
                    <option value="percentage">Percentage</option>
                </select>
                <button
                    class="btn btn-primary btn-sm mt-1 o_add_computed_measure"
                    type="button"
                    t-on-click="this.addMeasure"
                >Add</button>
            </div>
        </AccordionItem>
    </t>
</templates>

<templates xml:space="preserve">

    <t
        t-name="web_m2x_options.AutoComplete"
        t-inherit="web.AutoComplete"
        t-inherit-mode="extension"
    >
        <xpath expr="//t[@t-foreach='source.options']/li/t" position="attributes">
            <attribute name="t-attf-style">{{ option.style }}</attribute>
        </xpath>
        <xpath
            expr="//t[@t-foreach='source.options']/li/t/t[@t-slot]"
            position="before"
        >
            <i
                t-if="option.icon"
                t-attf-class="fa {{ option.icon }} fa-fw me-1 text-muted"
                aria-hidden="true"
            />
        </xpath>
    </t>

     <t
        t-name="web_m2x_options.Many2ManyTagsField"
        t-inherit="web.Many2ManyTagsField"
        t-inherit-mode="extension"
    >
        <xpath expr="//Many2XAutocomplete" position="attributes">
            <attribute name="searchLimit">props.searchLimit</attribute>
            <attribute name="fieldColor">props.fieldColor</attribute>
            <attribute name="fieldColorOptions">props.fieldColorOptions</attribute>
            <attribute name="fieldColorStyle">props.fieldColorStyle</attribute>
            <attribute name="fieldIcon">props.fieldIcon</attribute>
            <attribute name="fieldIconOptions">props.fieldIconOptions</attribute>
        </xpath>
    </t>

</templates>

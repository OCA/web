<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="web_widget_sub_view_form.SubViewForm">
        <!-- nothing shown while the reference is empty -->
        <div t-if="this.ref" class="o_sub_view_form">
            <!-- t-key: rebuild the view when the reference changes -->
            <View
                t-key="this.ref.resModel + ',' + this.ref.resId"
                t-props="this.viewProps"
            />
        </div>
    </t>
</templates>

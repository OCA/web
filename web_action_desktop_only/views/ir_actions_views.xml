<odoo>

    <record id="view_window_action_form" model="ir.ui.view">
        <field name="name">ir.actions.act_window.form.desktop_only</field>
        <field name="model">ir.actions.act_window</field>
        <field name="inherit_id" ref="base.view_window_action_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='security']" position="inside">
                <group name="desktop_only" string="Mobile Visibility">
                    <field name="desktop_only" />
                    <field name="main_action" />
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_client_action_form" model="ir.ui.view">
        <field name="name">ir.actions.client.form.desktop_only</field>
        <field name="model">ir.actions.client</field>
        <field name="inherit_id" ref="base.view_client_action_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='action_details']" position="after">
                <group name="desktop_only" string="Mobile Visibility">
                    <field name="desktop_only" />
                    <field name="main_action" />
                </group>
            </xpath>
        </field>
    </record>

</odoo>

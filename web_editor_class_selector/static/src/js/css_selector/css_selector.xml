<templates xml:space="preserve">
    <t t-name="web_editor_class_selector.CssSelector">
        <Dropdown>
            <button
                class="btn btn-light"
                t-att-title="this.props.title"
                t-att-disabled="this.props.isDisabled"
            >
                <span class="px-1" t-out="this.state.displayName" />
            </button>
            <t t-set-slot="content">
                <t t-foreach="this.items" t-as="item" t-key="item_index">
                    <DropdownItem
                        class="item.class_name"
                        onSelected="() => this.onSelected(item)"
                        t-on-pointerdown.prevent="() => {}"
                    >
                        <t t-out="item.name" />
                    </DropdownItem>
                </t>
            </t>
        </Dropdown>
    </t>
</templates>

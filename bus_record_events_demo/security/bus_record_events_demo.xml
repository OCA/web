<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="bus_record_event_demo_rule_user" model="ir.rule">
        <field name="name">Bus Record Event Demo: User own records</field>
        <field name="model_id" ref="model_bus_record_event_demo" />
        <field
            name="domain_force"
        >['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="bus_record_event_demo_rule_admin" model="ir.rule">
        <field name="name">Bus Record Event Demo: Admin all records</field>
        <field name="model_id" ref="model_bus_record_event_demo" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]" />
    </record>
</odoo>

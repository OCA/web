<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!--
    DiagramController template.
    "New Node" button is rendered inside the view area (not the control panel)
    to keep the integration simple. Control panel slot integration can be added
    later via the Layout component from @web/search/layout.
-->
<t t-name="web_diagram.DiagramController" owl="1">
    <div class="o_diagram_view h-100 d-flex flex-column">
        <div class="o_diagram_view_buttons p-2">
            <button type="button" class="btn btn-primary o_diagram_new_button"
                    t-on-click="addNode">
                New Node
            </button>
        </div>
        <DiagramRenderer
            nodes="state.nodes"
            edges="state.edges"
            labels="state.labels"
            onEditNode.bind="editNode"
            onRemoveNode.bind="removeNode"
            onEditEdge.bind="editEdge"
            onAddEdge.bind="addEdge"
            onRemoveEdge.bind="removeEdge"
        />
    </div>
</t>

<!-- DiagramRenderer template. -->
<t t-name="web_diagram.DiagramView" owl="1">
    <div class="o_diagram_header">
        <t t-foreach="props.labels" t-as="label" t-key="label_index">
            <span t-esc="label"/>
        </t>
    </div>
    <div class="o_diagram" t-ref="diagram"/>
</t>

</templates>

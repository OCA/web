<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_web_diagram_nav_help_form" model="ir.ui.view">
        <field name="name">web.diagram.nav.help.form</field>
        <field name="model">web.diagram.nav.help</field>
        <field name="arch" type="xml">
            <form string="Navigation Tips">
                <sheet>
                    <field name="content_html" readonly="1" nolabel="1"/>

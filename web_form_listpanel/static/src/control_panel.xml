<templates xml:space="preserve">
    <t t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_cp_pager')]" position="before">
            <button
                t-if="showListPanelAuto"
                type="button"
                class="o_listpanel_auto_toggle btn btn-secondary"
                t-att-class="{active: listPanelAutoState.shown}"
                title="Show or hide the list panel"
                t-on-click="() => listPanelAuto.toggle()"
            >
                <i class="fa fa-list" />
            </button>
        </xpath>
    </t>
</templates>

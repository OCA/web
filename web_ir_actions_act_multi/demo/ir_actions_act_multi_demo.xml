<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="demo_act_multi" model="ir.actions.server">
        <field name="name">Run multiple actions</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="state">code</field>
        <field name="code">action = {
    "type": "ir.actions.act_multi",
    "actions": [
        {
            "type": "ir.actions.client",
            "tag": "display_notification",
            "params": {"message": "First action executed", "sticky": True},
        },
        {
            "type": "ir.actions.act_window",
            "name": "Second action executed",
            "res_model": "res.partner",
            "views": [[False, "list"]],
            "domain": [["id", "in", records.ids]],
        },
    ],
}</field>
    </record>

    <record id="demo_action" model="ir.actions.act_window">
        <field name="name">web_ir_actions_act_multi demo</field>
        <field name="path">web_ir_actions_act_multi_demo</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="str([['id', '=', ref('base.partner_admin')]])" />
    </record>

    <!-- Adding a redundant button to the partner form so that this module can be tested on runbot.
    You might be more interested in returning this action type from a method in your code. -->
    <record id="view_partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <div class="oe_button_box" position="inside">
                <button
                    name="%(web_ir_actions_act_multi.demo_act_multi)d"
                    type="action"
                    string="Run multiple actions"
                    icon="fa-forward"
                    class="oe_stat_button"
                />
            </div>
        </field>
    </record>
</odoo>

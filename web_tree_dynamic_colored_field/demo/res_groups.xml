<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.model.fields" id="access_right_background_color">
        <field name="name">x_background_color</field>
        <field name="model_id" ref="base.model_ir_model_access" />
        <field name="field_description">Background Color</field>
        <field name="ttype">char</field>
    </record>

    <record model="ir.model.fields" id="access_right_foreground_color">
        <field name="name">x_foreground_color</field>
        <field name="model_id" ref="base.model_ir_model_access" />
        <field name="field_description">Foreground Color</field>
        <field name="ttype">char</field>
    </record>

    <record id="view_res_group_form" model="ir.ui.view">
        <field name="name">res.groups.form</field>
        <field name="model">res.groups</field>
        <field name="inherit_id" ref="base.view_groups_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']//list" position="attributes">
                <attribute
                    name="colors"
                >bg_color_field: x_background_color; fg_color_field: x_foreground_color</attribute>
            </xpath>
            <xpath
                expr="//notebook/page[@name='access_rights']//list"
                position="inside"
            >
                <field name="x_background_color" />
                <field name="x_foreground_color" />
            </xpath>
        </field>
    </record>
</odoo>

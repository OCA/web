<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t
        t-name="web_chatter_remove_call_buttons.DiscussSidebar"
        t-inherit="mail.DiscussSidebar"
        t-inherit-mode="extension"
    >
        <xpath
            expr="//button[hasclass('o_DiscussSidebar_startAMeetingButton')]/ancestor::div[1]"
            position="attributes"
            t-if="discussView"
        >
            <attribute name="t-if">False</attribute>
        </xpath>

        <xpath
            expr="//hr[hasclass('o_DiscussSidebar_separator')][1]"
            position="attributes"
            t-if="discussView"
        >
            <attribute name="t-if">False</attribute>
        </xpath>
    </t>

</templates>

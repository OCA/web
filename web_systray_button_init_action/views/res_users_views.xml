<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_users_form_init_action" model="ir.ui.view">
        <field name="name">res.users.form.init.action</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="action_id" invisible="share" groups="base.group_no_one" />
            </xpath>
        </field>
    </record>
</odoo>

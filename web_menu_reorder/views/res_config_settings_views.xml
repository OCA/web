<odoo>
    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.menu.reorder</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='languages']" position="before">
                <h2 name="menu_setting">Menu</h2>
                <div class="row mt16 o_settings_container" id="menu_interface_section">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane" />
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Compute menu item order</span>
                            <div class="content-group">
                                <field name="menu_reorder_algorithm_lang_to_order" />
                                <field
                                    name="menu_reorder_lang_to_order"
                                    invisible="menu_reorder_algorithm_lang_to_order not in ['by_alphabetical', 'by_label']"
                                />
                            </div>
                            <div class="content-group" invisible="menu_reorder_algorithm_lang_to_order != 'by_label'">
                                <div class="text-muted">Enter menu labels, one per line.</div>
                                <field name="menu_order_labels" widget="text" />
                            </div>
                            <div class="content-group">
                                <button
                                    name="execute_menu_reorder"
                                    type="object"
                                    string="Reorder Menus"
                                    class="btn-primary"
                                />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

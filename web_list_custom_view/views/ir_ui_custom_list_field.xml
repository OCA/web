<odoo>
    <record id="ir_ui_custom_list_field_form_view" model="ir.ui.view">
        <field name="model">ir.ui.custom.list.field</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="field_name" />
                        <field name="field_id" />
                        <field name="model_name" />
                        <field name="model_id" />
                        <field name="position_after" />
                        <field name="optional" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ir_ui_custom_list_field_tree_view" model="ir.ui.view">
        <field name="model">ir.ui.custom.list.field</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="sequence" widget="handle" />
                <field name="model_id" />
                <field name="name" />
                <field name="field_id" />
                <field name="position_after" />
                <field name="optional" />
            </list>
        </field>
    </record>

    <record id="ir_ui_custom_list_field_act_window" model="ir.actions.act_window">
        <field name="name">Customize list view</field>
        <field name="res_model">ir.ui.custom.list.field</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <menuitem
        id="menu_ir_ui_custom_field_filter"
        action="ir_ui_custom_list_field_act_window"
        parent="base.next_id_2"
        sequence="6"
    />
</odoo>

<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-inherit="web.X2ManyField" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_x2m_control_panel')]" position="after">
            <t t-if="props.viewMode === 'list' and isX2ManySearchable">
                <div
                    class="o_x2m_search_panel mb-0 mb-md-2 pb-0 pb-md-2 d-flex justify-content-end"
                    role="search"
                >
                    <div
                        class="o_cp_searchview d-flex input-group"
                        style="max-width: 520px; padding-bottom: 10px;"
                    >
                        <div
                            class="o_searchview form-control form-control-sm d-flex align-items-center py-0 py-md-1 border-end-0"
                            role="search"
                            aria-autocomplete="list"
                        >
                            <button
                                class="btn border-0 p-0"
                                role="button"
                                aria-label="Search..."
                                title="Search..."
                            >
                                <i
                                    t-att-class="x2mSearchState.isLoading ? 'o_searchview_icon oi oi-search me-2 d-none' : 'o_searchview_icon oi oi-search me-2'"
                                    role="img"
                                />
                                <i
                                    t-if="x2mSearchState.isLoading"
                                    class="fa fa-spinner fa-spin me-2"
                                    role="img"
                                />
                            </button>
                            <div
                                class="o_searchview_input_container d-flex flex-grow-1 flex-wrap gap-0 gap-md-1 mw-100"
                            >
                                <t t-foreach="x2mFacets" t-as="facet" t-key="facet.key">
                                    <div
                                        class="o_searchview_facet position-relative d-inline-flex align-items-stretch rounded-2 bg-200 text-nowrap opacity-trigger-hover mw-100"
                                        t-att-class="{o_facet_with_domain: facet.domain }"
                                        role="listitem"
                                        aria-label="search"
                                        tabindex="0"
                                    >
                                        <div
                                            class="position-absolute start-0 top-0 bottom-0 end-0 bg-view border rounded-2 shadow opacity-0 opacity-100-hover"
                                        />
                                        <div
                                            class="o_searchview_facet_label position-relative rounded-start-2 px-1 rounded-end-0 p-0"
                                            t-on-click="(ev) => this.onX2mFacetLabelClick(ev.target, facet)"
                                            t-att-role="facet.domain ? 'button' : 'img'"
                                            t-att-class="{'btn btn-primary': true, 'cursor-pointer': facet.domain}"
                                        >
                                            <small class="px-1" t-esc="facet.title" />
                                            <span
                                                t-if="facet.domain"
                                                class="position-absolute start-0 top-0 bottom-0 end-0 bg-inherit opacity-0 opacity-100-hover px-2 transition-base"
                                            >
                                                <i class="fa fa-fw fa-pencil" />
                                            </span>
                                        </div>
                                        <div
                                            class="o_facet_values position-relative d-flex flex-wrap align-items-center ps-2 rounded-end-2 text-wrap overflow-hidden"
                                        >
                                            <t
                                                t-foreach="facet.values"
                                                t-as="facetValue"
                                                t-key="facetValue_index"
                                            >
                                                <em
                                                    t-if="!facetValue_first"
                                                    class="o_facet_values_sep small fw-bold mx-1 opacity-50"
                                                    t-esc="facet.separator"
                                                />
                                                <small
                                                    class="o_facet_value text-truncate"
                                                    t-esc="facetValue"
                                                    t-att-title="facet.tooltip or facetValue"
                                                />
                                            </t>
                                            <button
                                                class="o_facet_remove oi oi-close btn btn-link py-0 px-2 text-danger d-print-none"
                                                role="button"
                                                aria-label="Remove"
                                                title="Remove"
                                                t-on-click="() => this.onX2mFacetRemove(facet)"
                                                tabindex="-1"
                                            />
                                        </div>
                                    </div>
                                </t>
                                <input
                                    type="text"
                                    class="o_searchview_input o_input flex-grow-1 w-auto border-0"
                                    placeholder="Search..."
                                    role="searchbox"
                                    t-att-disabled="x2mSearchState.disabled"
                                    t-att-placeholder="x2mSearchState.disabled ? x2mSearchState.disabledReason : x2mSearchState.placeholder"
                                    t-att-value="x2mSearchState.query"
                                    t-on-input="onX2mSearchInput"
                                    t-on-keydown="onX2mSearchKeydown"
                                />
                            </div>
                        </div>
                        <button
                            type="button"
                            class="btn btn-outline-secondary btn-sm"
                            t-att-class="x2mSearchState.advancedDomain !== '[]' ? 'active' : ''"
                            t-att-disabled="x2mSearchState.disabled"
                            t-on-click="onX2mAdvancedDomain"
                            t-att-title="x2mSearchState.advancedLabel"
                            aria-label="Advanced"
                        >
                            <i class="fa fa-sliders" role="img" />
                        </button>
                        <button
                            type="button"
                            class="btn btn-outline-secondary btn-sm"
                            t-att-disabled="x2mSearchState.disabled or (!x2mSearchState.query and x2mSearchState.advancedDomain === '[]')"
                            t-on-click="onX2mClearSearch"
                            t-att-title="x2mSearchState.clearLabel"
                            aria-label="Clear"
                        >
                            <i class="fa fa-times" role="img" />
                        </button>
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>

<templates xml:space="preserve">

    <t t-inherit="web.SwitchCompanyMenu" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('oe_topbar_name')]" position="before">
            <t t-if="selectedCompanies.length > 1">
                <i
                    class="fa me-1 d-lg-inline-block o_company_context_highlighted"
                    title="Multiple companies selected"
                >
                    <t t-esc="selectedCompanies.length" />
                </i>
            </t>
        </xpath>
    </t>

</templates>

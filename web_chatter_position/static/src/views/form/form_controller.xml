<templates xml:space="preserve">

    <t
        t-name="web_chatter_position.FormView"
        t-inherit="web.FormView"
        t-inherit-mode="extension"
    >
        <xpath expr="//t[@t-set-slot='control-panel-buttons']" position="inside">
            <button
                t-if="this.isChatterToggleVisible"
                type="button"
                class="btn btn-secondary o_chatter_position_button"
                t-on-click="this.onClickChangePosition"
                title="Toggle chatter position"
            >
                <i class="oi" data-icon="swap_horiz" />
            </button>
        </xpath>
    </t>

</templates>

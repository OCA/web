<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="web_html_field_translate_dialog.HtmlTranslationDialog">
        <Dialog title="title" size="'lg'">
            <div class="o_html_translation_dialog">
                <t t-foreach="translations" t-as="term" t-key="term.lang">
                    <div
                        class="o_html_translation_lang mb-3"
                        t-att-class="{o_language_current: isCurrentLang(term.lang)}"
                    >
                        <div
                            class="d-flex align-items-center justify-content-between mb-1"
                        >
                            <label class="o_form_label fw-bold" t-esc="term.langName" />
                            <button
                                class="o_html_translation_codeview_btn btn btn-sm btn-link p-0"
                                type="button"
                                t-att-title="state.codeView[term.lang] ? 'Rich text view' : 'HTML source view'"
                                t-on-click="() => this.toggleCodeView(term.lang)"
                            >
                                <i
                                    class="fa"
                                    t-att-class="state.codeView[term.lang] ? 'fa-eye' : 'fa-code'"
                                />
                            </button>
                        </div>
                        <div class="o_html_translation_editor border rounded">
                            <t t-if="state.codeView[term.lang]">
                                <textarea
                                    class="o_codeview w-100 border-0 font-monospace"
                                    t-att-value="state.source[term.lang]"
                                    t-on-input="(ev) => this.onCodeInput(term.lang, ev)"
                                />
                            </t>
                            <t t-else="">
                                <Wysiwyg
                                    config="getConfig(term)"
                                    onLoad="(editor) => this.onEditorLoad(term.lang, editor)"
                                />
                            </t>
                        </div>
                    </div>
                </t>
            </div>
            <t t-set-slot="footer">
                <button
                    class="btn btn-primary"
                    t-on-click="() => this.onSave()"
                >Save</button>
                <button
                    class="btn btn-secondary"
                    t-on-click="() => this.props.close()"
                >Discard</button>
            </t>
        </Dialog>
    </t>

</templates>
